cat << 'EOF' > detector.py
import cv2
from ultralytics import YOLO

# 1. Load models
yolo_model = YOLO("yolov8n.pt")
face_cascade = cv2.CascadeClassifier("haarcascade_frontalface_default.xml")

# 2. Try camera indices
camera_indexes = [0, 2, 4, -1]
cap = None

for idx in camera_indexes:
    print(f"Trying to connect to camera index {idx}...")
    cap = cv2.VideoCapture(idx, cv2.CAP_V4L2)
    if cap.isOpened():
        ret, frame = cap.read()
        if ret and frame is not None:
            print(f"Successfully connected to working camera at index {idx}!")
            break
        cap.release()

if cap is None or not cap.isOpened():
    print("Error: Could not find any active working webcam streams.")
    exit()

print("Webcam live! Press 'q' to exit.")

while True:
    ret, frame = cap.read()
    if not ret or frame is None:
        continue

    # 3. Convert frame to grayscale
    gray_img = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    yolo_input = cv2.cvtColor(gray_img, cv2.COLOR_GRAY2BGR)

    # 4. Detect human bodies
    yolo_results = yolo_model(yolo_input, classes=[0], conf=0.4, verbose=False)

    for result in yolo_results:
        boxes = result.boxes
        for box in boxes:
            # FIX: Added [0] to extract the 1D tensor array out of the nested list layout
            hx1, hy1, hx2, hy2 = map(int, box.xyxy[0])
            
            # Crop to body bounds
            human_crop = gray_img[hy1:hy2, hx1:hx2]
            if human_crop.size == 0:
                continue
                
            # 5. Search for face signatures strictly inside body frame
            faces = face_cascade.detectMultiScale(human_crop, scaleFactor=1.1, minNeighbors=4, minSize=(30, 30))
            
            for (fx, fy, fw, fh) in faces:
                face_x1 = hx1 + fx
                face_y1 = hy1 + fy
                face_x2 = face_x1 + fw
                face_y2 = face_y1 + fh
                
                # Draw box around ONLY the face
                cv2.rectangle(yolo_input, (face_x1, face_y1), (face_x2, face_y2), (0, 255, 0), 2)
                cv2.putText(yolo_input, "Human Face", (face_x1, face_y1 - 10), 
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

    # Display video
    cv2.imshow("Grayscale Human Face Detector", yolo_input)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
EOF
